# Nom de domaine de l'application (doit pointer vers le serveur Traefik)
APP_HOST=escalade.example.org

# Base de données
POSTGRES_PASSWORD=change-me

# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Premier super administrateur, créé au démarrage s'il n'en existe aucun.
# Après la première connexion, changez le mot de passe puis retirez ces deux lignes.
SUPERADMIN_EMAIL=admin@example.org
SUPERADMIN_PASSWORD=change-me-please

# Rafraîchissement automatique des sites OSM, en jours (0 = désactivé)
SITES_REFRESH_DAYS=30

# --- Mot de passe oublié : serveur SMTP classique (obligatoire pour cette fonction) ---
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org
SMTP_FROM_NAME=Climbing Planner
# starttls (587), ssl (465) ou none (réseau de confiance uniquement)
SMTP_SECURITY=starttls

# --- Journalisation ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (lisible) ou json (pour Loki, ELK…)
LOG_FORMAT=text
# Durée de conservation du journal d'audit consultable dans l'appli (jours, 0 = illimité)
AUDIT_RETENTION_DAYS=180
